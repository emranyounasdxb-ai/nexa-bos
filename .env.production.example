# Copy these names into an untracked .env file on the production host.
# Never commit real credentials or secrets.

# Required PostgreSQL settings. Use a long, random, URL-safe password.
AMAFH_POSTGRES_USER=
AMAFH_POSTGRES_PASSWORD=
AMAFH_POSTGRES_DB=

# Required public HTTPS origin, without a trailing slash.
CORS_ORIGINS=
WEB_ORIGIN=
NEXT_PUBLIC_API_URL=

# Optional settings.
LOG_LEVEL=INFO
WEB_PORT=3000

# Required only for first-time OWNER bootstrap. Clear it after OWNER creation.
BOOTSTRAP_SECRET=
