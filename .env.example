# Copy to .env and adjust. Never commit real secrets.

# --- API ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql+asyncpg://nexa:nexa@localhost:15432/nexa_bos

# --- PostgreSQL (Compose) ---
# Prefixed so a machine-level POSTGRES_PASSWORD does not change local Compose.
NEXA_POSTGRES_USER=nexa
NEXA_POSTGRES_PASSWORD=nexa
NEXA_POSTGRES_DB=nexa_bos
# Host port is 15432 so a machine-level PostgreSQL on 5432 is not used.
NEXA_POSTGRES_PORT=15432

# --- Ports ---
API_PORT=8000
WEB_PORT=3000

# --- Web ---
# Browser-facing API origin
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional server-side API origin (defaults to NEXT_PUBLIC_API_URL)
API_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000

# --- First-time OWNER bootstrap ---
# Required only until the first OWNER is created. After that, bootstrap is permanently disabled.
BOOTSTRAP_SECRET=

# Optional: force Secure cookie flag (defaults to true only when APP_ENV=production)
# SESSION_COOKIE_SECURE=false
